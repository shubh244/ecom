# Public API (Laravel). Must include /api suffix in production.
# Local: http://localhost:8000/api
# Production (Render): https://api.shreejeeblessingwood.in/api
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Canonical storefront URL for SEO (sitemap, Open Graph, JSON-LD). No trailing slash.
# Production: https://www.shreejeeblessingwood.in (set in Vercel so SEO is not *.vercel.app)
NEXT_PUBLIC_SITE_URL=

# --- shreejeeblessingwood.in (GoDaddy DNS, keep default nameservers) ---
# 1) Vercel: add shreejeeblessingwood.in + www; GoDaddy: A @ → 76.76.21.21, CNAME www → cname.vercel-dns.com
# 2) Render: add api.shreejeeblessingwood.in; GoDaddy: CNAME api → your-service.onrender.com
# 3) Vercel env: NEXT_PUBLIC_SITE_URL + NEXT_PUBLIC_API_URL as above; redeploy.
# 4) Render env: APP_URL, FRONTEND_URL, CORS — see backend_new/.env.example
