APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Local: http://localhost — Production API host (asset URLs for uploads):
# APP_URL=https://api.shreejeeblessingwood.in
APP_URL=http://localhost

# Storefront URL for / redirect and CORS fallback (web.php)
# FRONTEND_URL=https://www.shreejeeblessingwood.in

# Razorpay (Checkout). When both are set, checkout uses Razorpay instead of manual UPI.
# Use the same Key Id / Key Secret as your live site (e.g. shreejeeblessingwood.in).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# UPI collect request (fallback when Razorpay keys are not set)
MERCHANT_UPI_VPA=merchant@upi
MERCHANT_UPI_NAME=Your Store Name

# Comma-separated browser origins (no trailing slashes). Include apex + www if both are used.
# Local:
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Custom domain:
# CORS_ALLOWED_ORIGINS=https://www.shreejeeblessingwood.in,https://shreejeeblessingwood.in

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local default
DB_CONNECTION=sqlite

# Railway + Supabase Postgres (production)
# DB_CONNECTION=pgsql
# Use Session Pooler URI on IPv4-only hosts (e.g. Render free tier)
# DB_URL=postgresql://postgres.<project-ref>:your-supabase-db-password@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# DATABASE_URL=${DB_URL}
#
# Or use split variables:
# DB_HOST=aws-0-<region>.pooler.supabase.com
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=postgres.<project-ref>
# DB_PASSWORD=your-supabase-db-password
# DB_SSLMODE=require

# ---------------------------------------------------------------------------
# One-time: import from Supabase (PostgreSQL) into Hostinger (MySQL)
# ---------------------------------------------------------------------------
# Keep DB_CONNECTION as your Hostinger target (mysql or mariadb).
#
# Set IMPORT_SOURCE_DB_* with your Supabase connection.
# Run:
#   php artisan db:import-from-supabase --force
#
# After import, remove IMPORT_SOURCE_DB_* and run: php artisan config:clear

# Full URI (optional if split vars below are set):
# IMPORT_SOURCE_DB_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
IMPORT_SOURCE_DB_URL=
IMPORT_SOURCE_DB_HOST=db.zdfjdgthqjlpssubsvzf.supabase.co
IMPORT_SOURCE_DB_PORT=5432
IMPORT_SOURCE_DB_DATABASE=postgres
IMPORT_SOURCE_DB_USERNAME=postgres
IMPORT_SOURCE_DB_PASSWORD=
IMPORT_SOURCE_DB_SCHEMA=public
IMPORT_SOURCE_DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
